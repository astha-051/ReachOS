# Nebius Token Factory Configuration (NVIDIA Nemotron Models)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model Routing Defaults
NEMOTRON_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_DEEP_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily Web Research API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Email Provider Setup (mock or resend)
EMAIL_PROVIDER=mock
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=outreach@reachos.ai

# Database Configuration (SQLite default for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./reachos.db

# Demo Mode & CORS
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
